{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "playground/**/*",
    "playground/**/*.vue"
  ],
  "exclude": [
    "playground/**/__tests__/*"
  ],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": [
        "./playground/*"
      ]
    }
  }
}
