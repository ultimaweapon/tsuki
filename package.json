{
  "name": "tsuki-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "run-s build-wasm type-check \"build-vue {@}\" --",
    "build-wasm": "node playground/build-wasm.js",
    "type-check": "vue-tsc --build",
    "build-vue": "vite build",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli playground/"
  },
  "dependencies": {
    "bootstrap": "^5.3.9",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "~10.11.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "3.9.6",
    "sass": "^1.108.2",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-wasm": "^3.6.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
